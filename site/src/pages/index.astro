---
import Icon from "../components/Icon.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { editions } from "../data/editions";
import { event } from "../data/site";
import { withBase } from "../utils/paths";
import "../styles/global.css";

const pageTitle = "Break The Beat | 3ra edición";
const description =
  "Sitio oficial de Break The Beat. Explora el impacto, highlights, sponsors e información de cada edición del torneo nacional de breaking en Guayaquil.";
const editionInfoUrl = (id: string) => `${withBase("/evento/")}?edicion=${id}`;
const resolveEditionHref = (href: string) => (href.startsWith("/") ? withBase(href) : href);
---

<!doctype html>
<html lang="es" data-edition="3">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={withBase("/assets/guayaquil-venue.webp")} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={withBase("/assets/favicon.png")} />
    <link rel="preload" as="image" href={withBase("/assets/guayaquil-venue.webp")} fetchpriority="high" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader isHome />

    <main id="inicio">
      <section class="edition-hero section-dark" aria-label="Ediciones de Break The Beat">
        {editions.map((edition) => (
          <article
            class="edition-hero-panel"
            data-edition-panel={edition.id}
            data-page-title={`Break The Beat | ${edition.label}`}
            hidden={!edition.isCurrent}
          >
            <div class="edition-hero-media" aria-hidden="true">
              <img
                src={withBase(edition.hero.image)}
                width="1600"
                height="900"
                alt=""
                fetchpriority={edition.isCurrent ? "high" : undefined}
                loading={edition.isCurrent ? "eager" : "lazy"}
                decoding="async"
              />
            </div>
            <div class="edition-hero-overlay"></div>
            <div class="edition-hero-inner">
              <div class="edition-hero-copy">
                <p class="eyebrow">{edition.hero.eyebrow}</p>
                <img
                  class="hero-logo"
                  src={withBase("/assets/break-the-beat-logo.webp")}
                  width="900"
                  height="569"
                  alt={event.title}
                />
                <h1>{edition.hero.title}</h1>
                <p class="hero-copy">{edition.hero.summary}</p>
                <div class="event-meta" aria-label="Información resumida del evento">
                  <span>
                    <Icon name="calendar-days" size={18} />
                    {edition.date}
                  </span>
                  <span>
                    <Icon name="map-pin" size={18} />
                    {edition.location}, {edition.city}
                  </span>
                </div>
                <div class="hero-actions">
                  <a class="button button-primary" href={editionInfoUrl(edition.id)}>
                    Ver información del evento
                    <Icon name="arrow-right" size={19} />
                  </a>
                  {edition.isCurrent ? (
                    <a class="button button-secondary" href={withBase("/inscripcion/")}>
                      Inscribirme para competir
                      <Icon name="ticket-check" size={18} />
                    </a>
                  ) : (
                    <a class="button button-secondary" href="#highlights">
                      Ver archivo de la edición
                      <Icon name="arrow-right" size={18} />
                    </a>
                  )}
                </div>
              </div>

              <aside class="stream-card" aria-label={edition.stream.title}>
                <div class="stream-card-heading">
                  <span>{edition.stream.eyebrow}</span>
                  <Icon name="camera" size={20} />
                </div>
                {edition.stream.embedUrl ? (
                  <iframe
                    src={edition.stream.embedUrl}
                    title={edition.stream.title}
                    allow="autoplay; encrypted-media; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                  ></iframe>
                ) : (
                  <div class="stream-placeholder">
                    <Icon name="camera" size={42} />
                    <div>
                      <h2>{edition.stream.title}</h2>
                      <p>{edition.stream.description}</p>
                    </div>
                  </div>
                )}
                <a
                  class="stream-link"
                  href={resolveEditionHref(edition.stream.href)}
                  target={edition.stream.href.startsWith("http") ? "_blank" : undefined}
                  rel={edition.stream.href.startsWith("http") ? "noreferrer" : undefined}
                >
                  {edition.stream.cta}
                  <Icon name="arrow-up-right" size={17} />
                </a>
              </aside>
            </div>
          </article>
        ))}

        <div class="edition-series">
          <label class="edition-picker">
            <span>
              <small>Event series</small>
              Elegir edición
            </span>
            <select data-edition-select aria-label="Elegir edición de Break The Beat">
              {editions.map((edition) => (
                <option value={edition.id} selected={edition.isCurrent}>
                  {edition.shortLabel} · {edition.year}
                </option>
              ))}
            </select>
          </label>
          {editions.map((edition) => (
            <div class="edition-series-meta" data-edition-panel={edition.id} hidden={!edition.isCurrent} aria-live="polite">
              <span>{edition.label}</span>
              <span>{edition.date}</span>
              <span>{edition.location}</span>
              <strong>{edition.status}</strong>
            </div>
          ))}
        </div>
      </section>

      <section class="edition-content section-light" id="impacto" aria-label="Impacto de la edición">
        {editions.map((edition) => (
          <div data-edition-panel={edition.id} hidden={!edition.isCurrent}>
            <div class="section-heading">
              <div class="section-label">
                <Icon name="megaphone" size={18} />
                {edition.impact.eyebrow}
              </div>
              <h2>{edition.impact.title}</h2>
              <p>{edition.impact.summary}</p>
            </div>
            <div class="story-card-grid">
              {edition.impact.cards.map((card) => (
                <article class="story-card">
                  <img src={withBase(card.image)} width="800" height="540" alt={card.alt} loading="lazy" decoding="async" />
                  <div>
                    <span>{card.eyebrow}</span>
                    <h3>{card.title}</h3>
                    <p>{card.text}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}
      </section>

      <section class="edition-content section-dark" id="highlights" aria-label="Highlights de la edición">
        {editions.map((edition) => (
          <div data-edition-panel={edition.id} hidden={!edition.isCurrent}>
            <div class="section-heading">
              <div class="section-label">
                <Icon name="sparkles" size={18} />
                {edition.highlights.eyebrow}
              </div>
              <h2>{edition.highlights.title}</h2>
              <p>{edition.highlights.summary}</p>
            </div>
            <div class="story-card-grid">
              {edition.highlights.cards.map((card) => (
                <article class="story-card story-card-dark">
                  <img src={withBase(card.image)} width="800" height="540" alt={card.alt} loading="lazy" decoding="async" />
                  <div>
                    <span>{card.eyebrow}</span>
                    <h3>{card.title}</h3>
                    <p>{card.text}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}
      </section>

      <section class="edition-content about-edition section-light" id="quienes-somos" aria-label="Quiénes somos">
        {editions.map((edition) => (
          <div class="about-edition-grid" data-edition-panel={edition.id} hidden={!edition.isCurrent}>
            <div>
              <div class="section-label">
                <Icon name="users-round" size={18} />
                {edition.about.eyebrow}
              </div>
              <h2>{edition.about.title}</h2>
            </div>
            <div class="about-edition-copy">
              {edition.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              <a class="text-link text-link-dark" href={editionInfoUrl(edition.id)}>
                Conocer esta edición
                <Icon name="arrow-right" size={18} />
              </a>
            </div>
          </div>
        ))}
      </section>

      <section class="edition-content section-dark" id="historia" aria-label="Historia de la edición">
        {editions.map((edition) => (
          <div data-edition-panel={edition.id} hidden={!edition.isCurrent}>
            <div class="section-heading compact">
              <div class="section-label">
                <Icon name="music-2" size={18} />
                Rewind · {edition.label}
              </div>
              <h2>La historia de esta edición.</h2>
            </div>
            <div class="milestone-grid">
              {edition.milestones.map((milestone) => (
                <article>
                  <span>{milestone.eyebrow}</span>
                  <h3>{milestone.title}</h3>
                  <p>{milestone.text}</p>
                </article>
              ))}
            </div>
          </div>
        ))}
      </section>

      <section class="edition-content sponsors-edition section-light" id="sponsors" aria-label="Sponsors de la edición">
        {editions.map((edition) => (
          <div data-edition-panel={edition.id} hidden={!edition.isCurrent}>
            <div class="section-heading">
              <div class="section-label">
                <Icon name="hand-heart" size={18} />
                {edition.sponsors.eyebrow}
              </div>
              <h2>{edition.sponsors.title}</h2>
              <p>{edition.sponsors.note}</p>
            </div>
            {edition.sponsors.items.length > 0 ? (
              <div class="sponsor-logo-grid">
                {edition.sponsors.items.map((sponsor) => (
                  <article class="sponsor-logo-card">
                    {sponsor.logo ? (
                      <img src={withBase(sponsor.logo)} width="360" height="200" alt={sponsor.name} loading="lazy" decoding="async" />
                    ) : (
                      <strong>{sponsor.name}</strong>
                    )}
                  </article>
                ))}
              </div>
            ) : (
              <div class="sponsor-empty">
                <span>Convocatoria 2026</span>
                <h3>Los sponsors se publicarán cuando estén confirmados.</h3>
                <p>Si tu marca quiere apoyar la tercera edición, contacta al equipo oficial de Break The Beat.</p>
                <a class="button button-secondary dark" href={`mailto:${event.email}`}>
                  Contactar al equipo
                  <Icon name="mail" size={18} />
                </a>
              </div>
            )}
          </div>
        ))}
      </section>

      <section class="edition-content edition-actions section-dark" aria-label="Acciones de la edición">
        {editions.map((edition) => (
          <div class="edition-actions-grid" data-edition-panel={edition.id} hidden={!edition.isCurrent}>
            <div>
              <p class="eyebrow">{edition.label} · {edition.year}</p>
              <h2>{edition.isCurrent ? "La pista te espera." : "Esta edición forma parte del archivo."}</h2>
            </div>
            <div class="edition-actions-buttons">
              <a class="button button-secondary" href={editionInfoUrl(edition.id)}>
                Información del evento
                <Icon name="arrow-right" size={18} />
              </a>
              {edition.isCurrent ? (
                <>
                  <a class="button button-primary" href={withBase("/inscripcion/")}>
                    Inscribirme
                    <Icon name="ticket-check" size={18} />
                  </a>
                  <a class="button button-secondary" href={withBase("/apoyar/")}>
                    Donar ahora
                    <Icon name="arrow-up-right" size={18} />
                  </a>
                </>
              ) : (
                <a class="button button-primary" href="#highlights">
                  Ver highlights
                  <Icon name="sparkles" size={18} />
                </a>
              )}
            </div>
          </div>
        ))}
      </section>

      <section class="contact section-light" id="contacto">
        <div>
          <div class="section-label">
            <Icon name="mail" size={18} />
            Contacto
          </div>
          <h2>Hablemos del movimiento.</h2>
        </div>
        <div class="contact-actions">
          <a class="button button-secondary dark" href={`mailto:${event.email}`}>{event.email}</a>
          <a class="button button-secondary dark" href={event.instagramUrl} target="_blank" rel="noreferrer">
            {event.instagram}
            <Icon name="arrow-up-right" size={18} />
          </a>
        </div>
      </section>
    </main>

    <SiteFooter />
    <script>
      import "../scripts/edition-switcher";
    </script>
  </body>
</html>
