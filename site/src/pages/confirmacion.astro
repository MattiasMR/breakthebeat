---
import Analytics from "../components/Analytics.astro";
import Icon from "../components/Icon.astro";
import { event } from "../data/site";
import { withBase } from "../utils/paths";
import "../styles/global.css";
import "../styles/portal.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Confirmación de inscripción a Break The Beat 2026." />
    <meta name="theme-color" content="#050505" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href={withBase("/assets/favicon.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>Inscripción confirmada | Break The Beat</title>
  </head>
  <body class="portal-body confirmation-standalone-body">
    <header class="registration-page-topline">
      <div>
        <a class="text-link portal-back" href={withBase("/")}><Icon name="arrow-left" size={18} /> Volver al inicio</a>
      </div>
    </header>
    <main class="confirmation-main">
      <section class="confirmation-shell" data-confirmation-shell hidden>
        <div class="confirmation-heading">
          <span class="success-icon"><Icon name="check-circle-2" size={38} /></span>
          <p class="eyebrow" data-confirmation-eyebrow>Todo está listo</p>
          <h1 data-confirmation-title>¡Ya estás inscrito!</h1>
          <p data-confirmation-copy>Descarga los códigos y preséntalos en el ingreso el día del evento. Cada participante tiene su propio QR.</p>
          <div class="confirmation-reference"><span data-confirmation-reference-label>Inscripción</span> <strong data-registration-code></strong></div>
        </div>
        <div class="confirmation-download-warning" data-download-warning></div>
        <div class="qr-grid" data-qr-grid></div>
        <div class="confirmation-security">
          <Icon name="shield-check" size={24} />
          <span>Los QR contienen únicamente un token aleatorio. No incluyen datos personales ni médicos.</span>
        </div>
        <button class="button button-primary confirmation-download-all" type="button" data-download-all disabled>Descargar QR</button>
      </section>

      <section class="confirmation-shell confirmation-empty" data-confirmation-empty hidden>
        <Icon name="qr-code" size={42} />
        <h1>No hay una confirmación reciente en esta pestaña.</h1>
        <p>Si ya te inscribiste y no guardaste tu QR, puedes recuperarlo con el mismo correo que usaste en el formulario.</p>
        <div class="confirmation-empty-actions">
          <a
            class="button button-primary"
            href={withBase("/inscripcion/#recuperar-qr")}
            data-analytics-registration-cta="confirmation_retry"
          >Recuperar mi QR</a>
          <a class="button button-secondary" href={`mailto:${event.email}`}>Contactar</a>
        </div>
      </section>
    </main>
    <script>
      import "../scripts/confirmation";
    </script>
    <Analytics />
  </body>
</html>
