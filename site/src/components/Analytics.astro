---
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() ?? "";
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID?.trim() ?? "";
const hasGoogleAnalytics = /^G-[A-Z0-9]+$/i.test(measurementId);
const hasMetaPixel = /^\d{5,20}$/.test(metaPixelId);
const isConfigured = hasGoogleAnalytics || hasMetaPixel;
---

{isConfigured && (
  <>
    <aside
      class="analytics-consent"
      data-analytics-consent
      role="dialog"
      aria-labelledby="analytics-consent-title"
      aria-describedby="analytics-consent-description"
      hidden
    >
      <div>
        <strong id="analytics-consent-title">Medición y publicidad</strong>
        <p id="analytics-consent-description">
          Usamos Google Analytics y Meta Pixel para medir visitas, inscripciones y la efectividad de las
          campañas. No enviamos nombres, datos de contacto ni información médica ingresada en el formulario.
        </p>
      </div>
      <div class="analytics-consent-actions">
        <button type="button" data-analytics-reject>No permitir</button>
        <button type="button" class="is-primary" data-analytics-accept>Permitir analítica</button>
      </div>
    </aside>

    <button class="analytics-preferences" type="button" data-analytics-preferences hidden>
      Privacidad
    </button>

    <script is:inline define:vars={{ measurementId, metaPixelId }}>
      (() => {
        const storageKey = "btb_analytics_consent_v2";
        const googleAnalyticsConfigured = /^G-[A-Z0-9]+$/i.test(measurementId);
        const metaPixelConfigured = /^\d{5,20}$/.test(metaPixelId);
        const banner = document.querySelector("[data-analytics-consent]");
        const acceptButton = document.querySelector("[data-analytics-accept]");
        const rejectButton = document.querySelector("[data-analytics-reject]");
        const preferencesButton = document.querySelector("[data-analytics-preferences]");
        if (!banner || !acceptButton || !rejectButton || !preferencesButton) return;

        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function gtag() { window.dataLayer.push(arguments); };
        window.gtag("consent", "default", {
          analytics_storage: "denied",
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied"
        });

        const readConsent = () => {
          try {
            const value = localStorage.getItem(storageKey);
            return value === "granted" || value === "denied" ? value : null;
          } catch {
            return null;
          }
        };
        const writeConsent = (value) => {
          try { localStorage.setItem(storageKey, value); } catch { /* storage unavailable */ }
        };

        let consent = readConsent();
        let googleAnalyticsLoaded = false;
        let metaPixelLoaded = false;

        const hideBanner = () => {
          banner.hidden = true;
          preferencesButton.hidden = false;
        };
        const showBanner = () => {
          banner.hidden = false;
          preferencesButton.hidden = true;
          acceptButton.focus();
        };
        const expireCookie = (name) => {
          const rootDomain = location.hostname.split(".").slice(-2).join(".");
          const expired = `${name}=; Max-Age=0; path=/`;
          document.cookie = expired;
          document.cookie = `${expired}; domain=${location.hostname}`;
          if (rootDomain.includes(".")) document.cookie = `${expired}; domain=.${rootDomain}`;
        };
        const removeAnalyticsCookies = () => {
          document.cookie.split(";").forEach((entry) => {
            const name = entry.split("=")[0]?.trim();
            if (!name || (!name.startsWith("_ga") && name !== "_fbp" && name !== "_fbc")) return;
            expireCookie(name);
          });
        };
        const loadGoogleAnalytics = () => {
          if (!googleAnalyticsConfigured || googleAnalyticsLoaded || consent !== "granted") return;
          googleAnalyticsLoaded = true;
          window.gtag("consent", "update", {
            analytics_storage: "granted",
            ad_storage: "denied",
            ad_user_data: "denied",
            ad_personalization: "denied"
          });
          window.gtag("js", new Date());
          window.gtag("config", measurementId, {
            allow_google_signals: false,
            allow_ad_personalization_signals: false
          });

          const script = document.createElement("script");
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
          document.head.append(script);
        };
        const loadMetaPixel = () => {
          if (!metaPixelConfigured || metaPixelLoaded || consent !== "granted") return;
          metaPixelLoaded = true;

          if (!window.fbq) {
            const fbq = (...args) => {
              if (fbq.callMethod) fbq.callMethod.apply(fbq, args);
              else fbq.queue.push(args);
            };
            fbq.push = fbq;
            fbq.loaded = true;
            fbq.version = "2.0";
            fbq.queue = [];
            window.fbq = fbq;
            window._fbq = fbq;
          }

          window.fbq("consent", "grant");
          window.fbq("init", metaPixelId);
          window.fbq("track", "PageView");
          if (/\/inscripcion\/?$/.test(location.pathname)) {
            window.fbq("track", "ViewContent", {
              content_name: "Inscripción Break The Beat 2026",
              content_category: "event_registration"
            });
          }

          const script = document.createElement("script");
          script.async = true;
          script.src = "https://connect.facebook.net/en_US/fbevents.js";
          document.head.append(script);
        };
        const trackMetaEvent = (eventName, parameters) => {
          if (!metaPixelConfigured || consent !== "granted") return;
          loadMetaPixel();
          if (eventName === "registration_complete") {
            window.fbq("track", "CompleteRegistration", parameters);
          } else if (eventName === "registration_start") {
            window.fbq("trackCustom", "RegistrationStart", parameters);
          } else if (eventName === "registration_cta_click") {
            window.fbq("trackCustom", "RegistrationCtaClick", parameters);
          }
        };

        window.btbAnalytics = {
          consentGranted: () => consent === "granted",
          openPreferences: showBanner,
          track: (eventName, parameters = {}) => {
            if (consent !== "granted") return;
            loadGoogleAnalytics();
            if (googleAnalyticsConfigured) window.gtag("event", eventName, parameters);
            trackMetaEvent(eventName, parameters);
          }
        };

        acceptButton.addEventListener("click", () => {
          consent = "granted";
          writeConsent(consent);
          loadGoogleAnalytics();
          loadMetaPixel();
          hideBanner();
        });
        rejectButton.addEventListener("click", () => {
          const wasGranted = consent === "granted";
          consent = "denied";
          writeConsent(consent);
          window.gtag("consent", "update", {
            analytics_storage: "denied",
            ad_storage: "denied",
            ad_user_data: "denied",
            ad_personalization: "denied"
          });
          if (window.fbq) window.fbq("consent", "revoke");
          removeAnalyticsCookies();
          hideBanner();
          if (wasGranted) location.reload();
        });
        preferencesButton.addEventListener("click", showBanner);

        document.addEventListener("click", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const cta = target.closest("[data-analytics-registration-cta]");
          if (!cta) return;
          window.btbAnalytics.track("registration_cta_click", {
            event_edition: "2026",
            cta_location: cta.getAttribute("data-analytics-registration-cta") || "unknown"
          });
        });

        if (consent === "granted") {
          loadGoogleAnalytics();
          loadMetaPixel();
          hideBanner();
        } else if (consent === "denied") {
          hideBanner();
        } else {
          showBanner();
        }
      })();
    </script>
  </>
)}

<style>
  .analytics-consent {
    position: fixed;
    z-index: 10000;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    display: flex;
    max-width: 760px;
    margin-inline: auto;
    padding: 1rem;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    color: #fff;
    background: #080808;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 16px;
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.45);
    font-family: Poppins, system-ui, sans-serif;
  }

  .analytics-consent[hidden],
  .analytics-preferences[hidden] {
    display: none !important;
  }

  .analytics-consent strong {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.95rem;
  }

  .analytics-consent p {
    max-width: 48ch;
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .analytics-consent-actions {
    display: flex;
    flex: 0 0 auto;
    gap: 0.55rem;
  }

  .analytics-consent button,
  .analytics-preferences {
    min-height: 40px;
    padding: 0.6rem 0.85rem;
    color: #fff;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: 999px;
    font: 600 0.75rem/1 Poppins, system-ui, sans-serif;
    cursor: pointer;
  }

  .analytics-consent button.is-primary {
    color: #080808;
    background: #ff3f97;
    border-color: #ff3f97;
  }

  .analytics-consent button:focus-visible,
  .analytics-preferences:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  .analytics-preferences {
    position: fixed;
    z-index: 9999;
    bottom: 0.75rem;
    left: 0.75rem;
    min-height: 34px;
    padding: 0.5rem 0.7rem;
    color: rgba(255, 255, 255, 0.82);
    background: rgba(8, 8, 8, 0.88);
    border-color: rgba(255, 255, 255, 0.25);
    font-size: 0.68rem;
    backdrop-filter: blur(10px);
  }

  @media (max-width: 680px) {
    .analytics-consent {
      align-items: stretch;
      flex-direction: column;
    }

    .analytics-consent-actions {
      display: grid;
      grid-template-columns: 1fr 1.25fr;
    }
  }
</style>
