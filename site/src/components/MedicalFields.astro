---
interface Props {
  prefix: "captain" | "partner";
  title: string;
}

const { prefix, title } = Astro.props;
---

<article class="medical-panel" data-medical-panel={prefix}>
  <div class="form-card-heading">
    <h3>{title}</h3>
  </div>
  <div class="emergency-block">
    <div class="field-grid">
      <label class="field">
        <span>Nombre completo <b aria-hidden="true">*</b></span>
        <input name={`${prefix}.medical.emergencyName`} required minlength="2" maxlength="120" placeholder={prefix === "captain" ? "José Eduardo" : "María Tornillo"} />
      </label>
      <label class="field">
        <span>Relación <b aria-hidden="true">*</b></span>
        <select name={`${prefix}.medical.emergencyRelationship`} required>
          <option value="">Seleccionar</option>
          <option>Padre</option>
          <option>Madre</option>
          <option>Hermano/a</option>
          <option>Pareja</option>
          <option>Amigo/a</option>
          <option>Otro</option>
        </select>
      </label>
      <label class="field">
        <span>Teléfono <b aria-hidden="true">*</b></span>
        <input name={`${prefix}.medical.emergencyPhone`} type="tel" required minlength="8" maxlength="24" title="Ingresa un número de teléfono válido" placeholder="0999999999" />
      </label>
    </div>
  </div>
</article>
