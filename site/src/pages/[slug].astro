---
import Analytics from "../components/Analytics.astro";
import Icon from "../components/Icon.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { donationAccount, event, featurePages } from "../data/site";
import { withBase } from "../utils/paths";
import "../styles/global.css";

export function getStaticPaths() {
  return featurePages.map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props;
const pageTitle = `${page.title} | ${event.title}`;
const description = page.summary;
const isDonationPage = page.slug === "apoyar";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={withBase(page.image)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={withBase("/assets/favicon.png")} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader />
    <main id="inicio" class="detail-page">
      <section class="detail-hero section-dark">
        <div class="detail-media" aria-hidden="true">
          <img src={withBase(page.image)} alt="" />
        </div>
        <div class="detail-overlay"></div>
        <div class="detail-content">
          <a class="text-link detail-back" href={withBase("/")}>
            <Icon name="arrow-left" size={18} />
            Volver
          </a>
          <p class="eyebrow">{page.eyebrow}</p>
          <h1>{page.title}</h1>
          <p>{page.summary}</p>
          {isDonationPage ? (
            <a class="button button-primary" href="#donar">
              Ver datos para transferir
              <Icon name="hand-heart" size={18} />
            </a>
          ) : (
            <a class="button button-primary" href={`mailto:${event.email}`}>
              Contacto oficial
              <Icon name="mail" size={18} />
            </a>
          )}
        </div>
      </section>

      {isDonationPage ? (
        <section class="donation-section section-light" id="donar">
          <div class="section-heading compact">
            <div class="section-label">Transferencia bancaria</div>
            <h2>Tu aporte está a dos pasos.</h2>
            <p>
              Copia los datos, abre la aplicación de tu banco y transfiere el monto que quieras.
              No necesitas completar formularios en esta página.
            </p>
          </div>

          <div class="donation-layout">
            <article class="donation-card" aria-labelledby="donation-account-title">
              <div class="donation-card-heading">
                <span class="donation-step">Paso 1</span>
                <div>
                  <p>Cuenta receptora</p>
                  <h3 id="donation-account-title">Copia los datos bancarios</h3>
                </div>
              </div>

              <dl class="donation-account-details">
                {[
                  { label: "Banco", value: donationAccount.bank },
                  { label: "Tipo de cuenta", value: donationAccount.accountType },
                  { label: "Número de cuenta", value: donationAccount.accountNumber, emphasize: true },
                  { label: "Titular", value: donationAccount.holder },
                  {
                    label: donationAccount.identificationType,
                    value: donationAccount.identification
                  }
                ].map((field) => (
                  <div class="donation-account-row">
                    <div>
                      <dt>{field.label}</dt>
                      <dd class:list={{ "is-emphasized": field.emphasize }}>{field.value}</dd>
                    </div>
                    <button
                      class="donation-copy-field"
                      type="button"
                      data-copy-value={field.value}
                      data-copy-name={field.label}
                      aria-label={`Copiar ${field.label.toLowerCase()}`}
                    >
                      <Icon name="copy" size={17} />
                      <span data-copy-button-label>Copiar</span>
                    </button>
                  </div>
                ))}
              </dl>

              <button
                class="button button-primary donation-copy-all"
                type="button"
                data-copy-value={`Banco: ${donationAccount.bank}\nTipo de cuenta: ${donationAccount.accountType}\nNúmero de cuenta: ${donationAccount.accountNumber}\nTitular: ${donationAccount.holder}\n${donationAccount.identificationType}: ${donationAccount.identification}\nMotivo sugerido: ${donationAccount.suggestedReason}`}
                data-copy-name="Todos los datos"
              >
                <Icon name="copy" size={18} />
                <span data-copy-button-label>Copiar todos los datos</span>
              </button>
              <p class="donation-feedback" data-donation-feedback aria-live="polite"></p>
              <p class="donation-help" id="donation-help">
                Antes de confirmar la transferencia, verifica que tu banco muestre como titular a
                <strong>{donationAccount.holder}</strong>.
              </p>
            </article>

            <div class="detail-list donation-assurances" aria-label="Cómo realizar la donación">
              <article class="donation-next-step">
                <span class="donation-step">Paso 2</span>
                <div>
                  <h3>Transfiere desde tu banco</h3>
                  <p>
                    Abre la aplicación o banca web de tu banco, registra esta cuenta y elige el
                    monto de tu aporte.
                  </p>
                </div>
              </article>
              {page.bullets.map((item) => (
                <article>
                  <span aria-hidden="true"></span>
                  <p>{item}</p>
                </article>
              ))}
            </div>
          </div>
        </section>
      ) : (
        <section class="detail-body section-light">
          <div class="section-heading compact">
            <div class="section-label">Detalle</div>
            <h2>Lo importante de esta parte.</h2>
          </div>
          <div class="detail-list">
            {page.bullets.map((item) => (
              <article>
                <span aria-hidden="true"></span>
                <p>{item}</p>
              </article>
            ))}
          </div>
        </section>
      )}
    </main>
    <SiteFooter />
    <script>
      import "../scripts/donation";
    </script>
    <Analytics />
  </body>
</html>
