---
import Icon from "../components/Icon.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { currentEdition, editions } from "../data/editions";
import { withBase } from "../utils/paths";
import "../styles/global.css";
import "../styles/portal.css";

const pageTitle = "Break The Beat | 3ra edición";
const description =
  "Sitio oficial de Break The Beat, competencia nacional de breaking y comunidad en Guayaquil.";
const galleryImages = Array.from({ length: 12 }, (_, index) =>
  withBase(`/assets/home-2026/gallery-${String(index + 1).padStart(2, "0")}.webp`)
);
const pastEditions = editions.filter((edition) => !edition.isCurrent);
const participationRules = [
  "Solo pueden inscribirse personas mayores de 18 años.",
  "Cada participante puede elegir una o más categorías: 1 vs 1, 2 vs 2 y BGirls.",
  "La inscripción 2 vs 2 requiere completar los datos de ambos integrantes de la dupla.",
  "Para completar el registro se solicitan datos de contacto y de emergencia válidos.",
  "Al finalizar se aceptan los términos, la privacidad, el tratamiento de datos de salud y la autorización de imagen y voz."
];
const homeSponsorLogo = (logo: string, editionId: string) => {
  if (editionId === "3") return withBase(logo);
  const filename = logo.split("/").at(-1)?.replace(/\.png$/i, ".webp") ?? "";
  return withBase(`/assets/sponsors/home/${filename}`);
};
---

<!doctype html>
<html lang="es" data-edition="3" data-home-overhaul>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={withBase("/assets/home-2026/hero-breaker.webp")} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={withBase("/assets/favicon.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style
      is:inline
      set:html={`
        @font-face {
          font-family: "Aurochs Heavy";
          src: url("${withBase("/assets/home-2026/aurochs-heavy.woff")}") format("woff");
          font-style: normal;
          font-weight: 800;
          font-display: swap;
        }
        @font-face {
          font-family: "Aurochs Regular";
          src: url("${withBase("/assets/home-2026/aurochs-regular.woff")}") format("woff");
          font-style: normal;
          font-weight: 500;
          font-display: swap;
        }
        @font-face {
          font-family: "Aurochs Light";
          src: url("${withBase("/assets/home-2026/aurochs-light.woff")}") format("woff");
          font-style: normal;
          font-weight: 300;
          font-display: swap;
        }
      `}
    ></style>
    <link rel="preload" as="image" href={withBase("/assets/home-2026/hero-breaker.webp")} fetchpriority="high" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader isHome variant="home" />
    <main id="inicio" class="home-page">
      <section class="home-hero" aria-label="Próxima edición de Break The Beat">
        {editions.filter((edition) => edition.isCurrent).map((edition) => (
          <article
            class="home-hero-panel"
          >
            <img
              class="home-hero-image"
              src={withBase(edition.isCurrent ? "/assets/home-2026/hero-breaker.webp" : edition.hero.image)}
              width={edition.isCurrent ? 2200 : 1600}
              height={edition.isCurrent ? 1467 : 900}
              alt={edition.hero.alt}
              fetchpriority={edition.isCurrent ? "high" : undefined}
              loading={edition.isCurrent ? "eager" : "lazy"}
              decoding="async"
            />
            <div class="home-hero-shade" aria-hidden="true"></div>
            {edition.isCurrent && (
              <>
                <img
                  class="home-graffiti-star home-graffiti-star-left"
                  src={withBase("/assets/home-2026/graffiti-star.webp")}
                  width="506"
                  height="760"
                  alt=""
                  aria-hidden="true"
                />
                <img
                  class="home-graffiti-star home-graffiti-star-right"
                  src={withBase("/assets/home-2026/graffiti-star.webp")}
                  width="506"
                  height="760"
                  alt=""
                  aria-hidden="true"
                />
              </>
            )}
            <div class="home-hero-content">
              <p class="home-date-pill">{edition.date}</p>
              <h1>
                {edition.isCurrent ? (
                  <>
                    <span>Un movimiento</span>
                    <strong>con impacto</strong>
                  </>
                ) : (
                  <>
                    <span>{edition.shortLabel}</span>
                    <strong>{edition.hero.title}</strong>
                  </>
                )}
              </h1>

              {!edition.isCurrent && (
                <p class="home-hero-summary">{edition.hero.summary}</p>
              )}

              {edition.isCurrent && edition.startsAt && (
                <div
                  class="home-countdown"
                  data-countdown
                  data-countdown-target={edition.startsAt}
                  role="timer"
                  aria-label={`Cuenta regresiva para ${edition.date}`}
                >
                  <div class="home-countdown-item">
                    <strong class="home-countdown-value" data-countdown-days>00</strong>
                    <span>Días</span>
                  </div>
                  <div class="home-countdown-item">
                    <strong class="home-countdown-value" data-countdown-hours>00</strong>
                    <span>Horas</span>
                  </div>
                  <div class="home-countdown-item">
                    <strong class="home-countdown-value" data-countdown-minutes>00</strong>
                    <span>Min</span>
                  </div>
                  <div class="home-countdown-item">
                    <strong class="home-countdown-value" data-countdown-seconds>00</strong>
                    <span>Seg</span>
                  </div>
                </div>
              )}

              <div class="home-hero-actions">
                {edition.isCurrent && (
                  <a class="home-button home-button-pink" href={withBase("/inscripcion/")}>¡Quiero unirme!</a>
                )}
              </div>
            </div>
          </article>
        ))}

      </section>

      <div class="home-tape" aria-hidden="true">
        <div class="home-tape-track">
          {Array.from({ length: 2 }, () => (
            <div class="home-tape-group">
              {Array.from({ length: 12 }, () => (
                <span>
                  <span><strong>break</strong> your <em>limits</em></span>
                  <img src={withBase("/assets/home-2026/dancer.svg")} width="24" height="39" alt="" />
                </span>
              ))}
            </div>
          ))}
        </div>
      </div>

      <section class="home-info" id="informacion" aria-labelledby="home-info-title">
        <nav class="home-info-tabs" aria-label="Información de Break The Beat">
          <a href="#informacion" aria-current="page">Información del evento</a>
          <a href="#reglas">Reglas</a>
        </nav>

        <div class="home-info-overview">
          <aside class="home-info-series" aria-label="Serie del evento">
            <p>Parte de la serie</p>
            <div>
              <img
                src={withBase("/assets/favicon.png")}
                width="96"
                height="96"
                alt=""
                aria-hidden="true"
              />
              <span>
                <strong>Break The Beat</strong>
                <small>{editions.length} ediciones</small>
              </span>
            </div>
          </aside>

          <article class="home-info-copy">
            <p class="kicker">{currentEdition.label} · {currentEdition.year}</p>
            <h2 id="home-info-title">Todo lo que necesitas saber antes de entrar a la pista.</h2>
            <p class="home-info-lead">{currentEdition.eventInfo.description}</p>
            <p>{currentEdition.about.paragraphs[1]}</p>

            <dl class="home-info-facts">
              <div>
                <dt><Icon name="calendar-days" size={18} /> Fecha</dt>
                <dd>{currentEdition.date}</dd>
              </div>
              <div>
                <dt><Icon name="map-pin" size={18} /> Lugar</dt>
                <dd>{currentEdition.location}, {currentEdition.city}</dd>
              </div>
              <div>
                <dt><Icon name="trophy" size={18} /> Categorías</dt>
                <dd>{currentEdition.eventInfo.categories.join(" · ")}</dd>
              </div>
            </dl>
          </article>
        </div>

        <section class="home-rules" id="reglas" aria-labelledby="home-rules-title">
          <header>
            <p class="kicker">Antes de competir</p>
            <h2 id="home-rules-title">Reglas de participación</h2>
            <p>Estas condiciones reflejan lo que actualmente valida el formulario oficial de inscripción.</p>
            <a class="home-button home-button-pink" href={withBase("/inscripcion/")}>
              Revisar e inscribirme
              <Icon name="arrow-up-right" size={18} />
            </a>
          </header>
          <ol>
            {participationRules.map((rule, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <p>{rule}</p>
              </li>
            ))}
          </ol>
        </section>

        <section class="home-past-editions" id="ediciones" aria-labelledby="past-editions-title">
          <header>
            <p class="kicker">El movimiento continúa</p>
            <h2 id="past-editions-title">Ediciones pasadas</h2>
          </header>
          <div class="home-past-grid">
            {pastEditions.map((edition) => (
              <article class="home-past-card">
                <img
                  src={withBase(edition.hero.image)}
                  width="1600"
                  height="900"
                  alt={edition.hero.alt}
                  loading="lazy"
                  decoding="async"
                />
                <div class="home-past-card-shade" aria-hidden="true"></div>
                <div class="home-past-card-copy">
                  <p>{edition.label} · {edition.year}</p>
                  <h3>{edition.hero.title}</h3>
                  <span>{edition.location}</span>
                </div>
              </article>
            ))}
          </div>
        </section>
      </section>

      <section class="home-about" id="evento">
        <img
          class="home-about-image"
          src={withBase("/assets/home-2026/community-breaker.webp")}
          width="2200"
          height="1467"
          alt="Breaker bailando en un espacio urbano de Guayaquil"
          loading="lazy"
          decoding="async"
        />
        <div class="home-about-shade" aria-hidden="true"></div>
        <div class="home-about-title">
          <h2>
            <span>Más que</span>
            <strong>un torneo,</strong>
            <span>una comunidad</span>
          </h2>
        </div>
        <div class="home-about-copy">
          <p>
            El breakdance ha sido históricamente un refugio. Desde inicios de los años 90 se comenzaron a reunir
            jóvenes alrededor del breaking como herramienta de resistencia y orgullo barrial.
          </p>
          <p>
            Break The Beat es una competencia nacional de breakdance creada para visibilizar el talento, la
            disciplina y las historias de sus bailarines.
          </p>
          <img src={withBase("/assets/home-2026/ucg-white.webp")} width="900" height="381" alt="Universidad Casa Grande" />
        </div>
      </section>

      <section class="home-editions" aria-label="Impacto y sponsors de Break The Beat">
        <section class="home-impact" id="impacto">
          <div class="home-impact-heading">
            <h2>Lo que <strong>ya logramos</strong></h2>
          </div>
          <div class="home-stat-grid" aria-label="Cifras acumuladas de Break The Beat">
            <article><b>↗</b><strong><span>+500</span> asistentes</strong><small>En nuestras anteriores dos ediciones</small></article>
            <article><b>↗</b><strong><span>+50</span> breakers</strong><small>Inscritos en diferentes categorías</small></article>
            <article><b>↗</b><strong><span>+40K</span> en medios</strong><small>Vistas e interacciones en medios</small></article>
            <article><b>↗</b><strong><span>1</span> documental</strong><small>Con reconocimientos internacionales</small></article>
          </div>
          <div class="home-gallery" aria-label="Galería de ediciones anteriores">
            {galleryImages.map((src) => <img src={src} width="1100" height="734" alt="" loading="lazy" decoding="async" />)}
          </div>
        </section>

        <section
          class="home-allies"
          id="sponsors"
          aria-label="Sponsors por edición"
          data-edition-sponsors
        >
          {editions.filter((edition) => edition.isCurrent).map((edition) => (
            <div
              class="home-allies-panel"
              data-edition-panel={edition.id}
              aria-label={`Sponsors de ${edition.shortLabel}`}
            >
              <h2 class="sr-only">{edition.sponsors.eyebrow}</h2>
              <div class="home-allies-logos">
                {edition.sponsors.items.map((sponsor) => (
                  <img src={homeSponsorLogo(sponsor.logo, edition.id)} width="480" height="120" alt={sponsor.name} loading="lazy" decoding="async" />
                ))}
              </div>
            </div>
          ))}
        </section>
      </section>

      <section class="home-final-cta">
        <img src={withBase("/assets/home-2026/dancer.svg")} width="115" height="184" alt="" aria-hidden="true" />
        <h2>La pista te espera</h2>
        <div>
          <a class="home-button home-button-pink" href={withBase("/inscripcion/")}>Inscribirme</a>
          <a class="home-button home-button-paper" href="#informacion">Información del evento</a>
        </div>
      </section>
    </main>

    <SiteFooter variant="home" />

    <script>
      import "../scripts/home-countdown";
    </script>
  </body>
</html>
