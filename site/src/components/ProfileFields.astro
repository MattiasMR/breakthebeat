---
interface Props {
  prefix: "captain" | "partner";
}

const { prefix } = Astro.props;
const ageHelpId = `${prefix}-age-help`;
---

<div class="field-grid">
  <label class="field">
    <span>Nombre y apellido <b aria-hidden="true">*</b></span>
    <input name={`${prefix}.legalName`} autocomplete="name" minlength="2" maxlength="70" required placeholder="José Eduardo" />
  </label>
  <label class="field">
    <span>Nombre artístico <b aria-hidden="true">*</b></span>
    <input name={`${prefix}.artisticName`} minlength="2" maxlength="45" required placeholder="Ríos" />
  </label>
  <label class="field">
    <span>
      Edad
      <span
        class="field-help"
        tabindex="0"
        aria-label="Información sobre el requisito de edad"
        aria-describedby={ageHelpId}
      >
        ⓘ
        <span class="field-help-tooltip" id={ageHelpId} role="tooltip">Solo pueden inscribirse mayores de edad.</span>
      </span>
      <b aria-hidden="true">*</b>
    </span>
    <input name={`${prefix}.age`} type="number" min="18" max="100" inputmode="numeric" required placeholder="+18" />
  </label>
  <label class="field">
    <span>Teléfono <b aria-hidden="true">*</b></span>
    <input name={`${prefix}.phone`} type="tel" autocomplete="tel" required minlength="8" maxlength="24" pattern="[+0-9][0-9 ()-]{7,22}" aria-describedby={`${prefix}-phone-error`} title="Usa entre 8 y 23 caracteres: números, espacios, paréntesis o guiones" placeholder="0999999999" />
    <small id={`${prefix}-phone-error`} class="field-validation-error" data-field-validation-error hidden></small>
  </label>
  <label class="field">
    <span>Correo electrónico <b aria-hidden="true">*</b></span>
    <input name={`${prefix}.email`} type="email" autocomplete="email" required maxlength="254" pattern="[^\s@]+@[^\s@]+\.[A-Za-z]{2,}" aria-describedby={`${prefix}-email-error`} placeholder="jose@correo.com" />
    <small id={`${prefix}-email-error`} class="field-validation-error" data-field-validation-error hidden></small>
  </label>
  <label class="field field-wide participant-photo-field">
    <span>Fotografía del participante <b aria-hidden="true">*</b></span>
    <input
      name={`${prefix}.photo`}
      type="file"
      accept="image/jpeg,image/png,image/webp"
      required
      aria-describedby={`${prefix}-photo-help`}
    />
    <small id={`${prefix}-photo-help`}>Usa una foto reciente donde se vea claramente el rostro. JPG, PNG o WebP; el sistema la optimiza antes de enviarla.</small>
  </label>
</div>
