---
interface Props {
  prefix: "captain" | "partner";
}

const { prefix } = Astro.props;
---

<div class="field-grid">
  <label class="field">
    <span>Nombre y apellido <b aria-hidden="true">*</b></span>
    <input name={`${prefix}.legalName`} autocomplete="name" minlength="2" maxlength="70" required placeholder="José Eduardo" />
  </label>
  <label class="field">
    <span>Nombre artístico <b aria-hidden="true">*</b></span>
    <input name={`${prefix}.artisticName`} minlength="2" maxlength="45" required placeholder="Ríos" />
  </label>
  <label class="field">
    <span>Edad <span class="field-help" title="Solo pueden inscribirse mayores de edad" aria-label="Solo pueden inscribirse mayores de edad">ⓘ</span> <b aria-hidden="true">*</b></span>
    <input name={`${prefix}.age`} type="number" min="18" max="100" inputmode="numeric" required placeholder="+18" />
  </label>
  <label class="field">
    <span>Teléfono <b aria-hidden="true">*</b></span>
    <input name={`${prefix}.phone`} type="tel" autocomplete="tel" required minlength="8" maxlength="24" title="Ingresa un número de teléfono válido" placeholder="0999999999" />
  </label>
  <label class="field">
    <span>Correo electrónico <b aria-hidden="true">*</b></span>
    <input name={`${prefix}.email`} type="email" autocomplete="email" required maxlength="254" placeholder="jose@correo.com" />
  </label>
</div>
