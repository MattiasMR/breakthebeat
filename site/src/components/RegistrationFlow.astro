---
import Icon from "./Icon.astro";
import CategoryFields from "./CategoryFields.astro";
import MedicalFields from "./MedicalFields.astro";
import ProfileFields from "./ProfileFields.astro";
import { withBase } from "../utils/paths";

interface Props {
  turnstileSiteKey: string;
  variant?: "page" | "modal";
}

const { turnstileSiteKey, variant = "page" } = Astro.props;
---

<div class:list={["registration-flow", { "registration-flow-modal": variant === "modal" }]}>
  <aside class="step-sidebar registration-progress" aria-label="Progreso de la inscripción">
    <div class="registration-summary-intro">
      <p class="step-sidebar-label">Inscripciones</p>
      <h1>Asegura tu cupo</h1>
      <p class="registration-event-copy">
        <span>Domingo 27 de septiembre, 10am</span>
        <span>Plaza de Teatros.</span>
      </p>
    </div>
    <div class="registration-progress-status">
      <ol data-progress-list>
        <li class="is-active" data-progress-phase="1"><span></span><strong class="sr-only">Datos de participantes</strong></li>
        <li data-progress-phase="2"><span></span><strong class="sr-only">Contacto de emergencia</strong></li>
        <li data-progress-phase="3"><span></span><strong class="sr-only">Términos y autorizaciones</strong></li>
      </ol>
      <strong data-progress-copy>Paso 1 de 3</strong>
    </div>
    <div class="secure-note"><Icon name="lock-keyhole" size={18} /><span>Conexión cifrada. Tus datos se envían de forma segura.</span></div>
  </aside>

  <div class="registration-panel">
    <div class="system-banner is-loading" data-registration-status role="status">
      Verificando si las inscripciones están abiertas…
    </div>
    <form id="registration-form" novalidate>
      <fieldset id="registration-fields" class="form-shell" disabled>
        <legend class="sr-only">Formulario de inscripción</legend>

        <section class="form-step is-active" data-form-step="categories">
          <div class="form-step-heading">
            <p class="step-kicker" data-step-kicker>Paso 1 de 3</p>
            <h2>Elige las categorías</h2>
            <p><strong>Selecciona ahora todas las categorías en las que deseas participar.</strong> Máximo 50 inscripciones por categoría. En 2 vs 2, una persona inscribe a la dupla: 50 duplas, 100 participantes.</p>
          </div>
          <CategoryFields prefix="captain" />
          <p class="field-error" data-category-error hidden>Selecciona al menos una categoría.</p>
          <div class="registration-profile-section">
            <h3>Tus datos</h3>
            <ProfileFields prefix="captain" />
          </div>
          <div class="form-actions align-end">
            <button class="button button-primary" type="button" data-next>Continuar</button>
          </div>
        </section>

        <section class="form-step" data-form-step="partner" hidden data-partner-step>
          <div class="form-step-heading">
            <p class="step-kicker" data-step-kicker>Paso 2 de 4</p>
            <h2>Datos de tu compañero</h2>
          </div>
          <input type="hidden" name="partner.categories" value="2v2" data-forced-category />
          <ProfileFields prefix="partner" />
          <div class="form-actions">
            <button class="button button-ghost" type="button" data-back><Icon name="arrow-left" size={18} /> Atrás</button>
            <button class="button button-primary" type="button" data-next>Continuar</button>
          </div>
        </section>

        <section class="form-step" data-form-step="emergency" hidden>
          <div class="form-step-heading">
            <p class="step-kicker" data-step-kicker>Paso 2 de 3</p>
            <h2>Contacto de emergencia</h2>
          </div>
          <div class="medical-stack">
            <MedicalFields prefix="captain" title="Tus datos" />
            <div data-partner-medical hidden>
              <MedicalFields prefix="partner" title="Datos de tu compañero" />
            </div>
          </div>
          <div class="submit-alert" data-medical-alert role="alert" hidden></div>
          <div class="form-actions">
            <button class="button button-ghost" type="button" data-back><Icon name="arrow-left" size={18} /> Atrás</button>
            <button class="button button-primary" type="button" data-next>Continuar</button>
          </div>
        </section>

        <section class="form-step" data-form-step="consents" hidden>
          <div class="form-step-heading">
            <p class="step-kicker" data-step-kicker>Paso 3 de 3</p>
            <h2>Términos y autorizaciones</h2>
          </div>
          <div class="legal-documents">
            <a
              class="legal-document"
              href={withBase("/assets/legal/autorizacion-imagen-y-voz.pdf")}
              target="_blank"
              rel="noreferrer"
              type="application/pdf"
            >
              <span><strong>Autorización de imagen y voz</strong></span>
            </a>
            <a
              class="legal-document"
              href={withBase("/assets/legal/terminos-y-condiciones-del-evento.pdf")}
              target="_blank"
              rel="noreferrer"
              type="application/pdf"
            >
              <span><strong>Términos y condiciones del evento</strong></span>
            </a>
          </div>
          <div class="consent-list">
            <label>
              <input type="checkbox" name="consent.responsibility" required />
              <span>Participo de forma voluntaria y bajo mi responsabilidad. Estoy en condiciones de bailar y entiendo que Break The Beat no se hace responsable por lesiones o problemas de salud durante el evento.</span>
            </label>
          </div>
          <p class="legal-acceptance">
            Al dar en Finalizar inscripción aceptas la{" "}
            <a href={withBase("/assets/legal/autorizacion-imagen-y-voz.pdf")} target="_blank" rel="noreferrer">Autorización de imagen y voz</a>
            {" "}y los{" "}
            <a href={withBase("/assets/legal/terminos-y-condiciones-del-evento.pdf")} target="_blank" rel="noreferrer">Términos y condiciones del evento</a>.
          </p>
          <div class="turnstile-block">
            {turnstileSiteKey ? (
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme={variant === "modal" ? "light" : "dark"} data-action="registration"></div>
            ) : (
              <p>Turnstile todavía no está configurado. El envío permanecerá bloqueado.</p>
            )}
          </div>
          <div class="submit-alert" data-submit-alert role="alert" hidden></div>
          <div class="form-actions">
            <button class="button button-ghost" type="button" data-back><Icon name="arrow-left" size={18} /> Atrás</button>
            <button class="button button-primary" type="submit" data-submit>Finalizar inscripción</button>
          </div>
        </section>
      </fieldset>
    </form>
  </div>
</div>
