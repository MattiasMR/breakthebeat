---
import Icon from "../components/Icon.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { editions } from "../data/editions";
import { withBase } from "../utils/paths";
import "../styles/global.css";

const pageTitle = "Break The Beat | 3ra edición";
const description =
  "Sitio oficial de Break The Beat, competencia nacional de breaking y comunidad en Guayaquil.";
const editionInfoUrl = (id: string) => `${withBase("/evento/")}?edicion=${id}`;
const galleryImages = Array.from({ length: 12 }, (_, index) =>
  withBase(`/assets/home-2026/gallery-${String(index + 1).padStart(2, "0")}.webp`)
);
const currentSponsors = editions.find((edition) => edition.isCurrent)?.sponsors.items ?? [];
---

<!doctype html>
<html lang="es" data-edition="3" data-home-overhaul>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={withBase("/assets/home-2026/hero-breaker.webp")} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={withBase("/assets/favicon.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style
      is:inline
      set:html={`
        @font-face {
          font-family: "Aurochs Heavy";
          src: url("${withBase("/assets/home-2026/aurochs-heavy.woff")}") format("woff");
          font-style: normal;
          font-weight: 800;
          font-display: swap;
        }
        @font-face {
          font-family: "Aurochs Regular";
          src: url("${withBase("/assets/home-2026/aurochs-regular.woff")}") format("woff");
          font-style: normal;
          font-weight: 500;
          font-display: swap;
        }
        @font-face {
          font-family: "Aurochs Light";
          src: url("${withBase("/assets/home-2026/aurochs-light.woff")}") format("woff");
          font-style: normal;
          font-weight: 300;
          font-display: swap;
        }
      `}
    ></style>
    <link rel="preload" as="image" href={withBase("/assets/home-2026/hero-breaker.webp")} fetchpriority="high" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader isHome variant="home" />

    <main id="inicio" class="home-page">
      <section class="home-hero" aria-label="Próxima edición de Break The Beat">
        {editions.map((edition) => (
          <article
            class="home-hero-panel"
            data-edition-panel={edition.id}
            data-page-title={`Break The Beat | ${edition.label}`}
            hidden={!edition.isCurrent}
          >
            <img
              class="home-hero-image"
              src={withBase(edition.isCurrent ? "/assets/home-2026/hero-breaker.webp" : edition.hero.image)}
              width={edition.isCurrent ? 2200 : 1600}
              height={edition.isCurrent ? 1467 : 900}
              alt={edition.hero.alt}
              fetchpriority={edition.isCurrent ? "high" : undefined}
              loading={edition.isCurrent ? "eager" : "lazy"}
              decoding="async"
            />
            <div class="home-hero-shade" aria-hidden="true"></div>
            {edition.isCurrent && (
              <img
                class="home-graffiti-star"
                src={withBase("/assets/home-2026/graffiti-star.webp")}
                width="506"
                height="760"
                alt=""
                aria-hidden="true"
              />
            )}
            <div class="home-hero-content">
              <p class="home-date-pill">{edition.date}</p>
              <h1>
                {edition.isCurrent ? (
                  <>
                    <span>Un movimiento</span>
                    <strong>con impacto</strong>
                  </>
                ) : (
                  <>
                    <span>{edition.shortLabel}</span>
                    <strong>{edition.hero.title}</strong>
                  </>
                )}
              </h1>

              {edition.isCurrent ? (
                <div
                  class="home-countdown"
                  data-countdown="2026-09-27T00:00:00-05:00"
                  aria-label="Cuenta regresiva para Break The Beat 2026"
                >
                  <div><div><strong data-countdown-days>00</strong></div><span>Días</span></div>
                  <div><div><strong data-countdown-hours>00</strong></div><span>Horas</span></div>
                  <div><div><strong data-countdown-minutes>00</strong></div><span>Min</span></div>
                  <div><div><strong data-countdown-seconds>00</strong></div><span>Seg</span></div>
                  <p class="sr-only" data-countdown-live aria-live="polite"></p>
                </div>
              ) : (
                <p class="home-hero-summary">{edition.hero.summary}</p>
              )}

              <div class="home-hero-actions">
                {edition.isCurrent && (
                  <a class="home-button home-button-pink" href={withBase("/inscripcion/")}>¡Quiero unirme!</a>
                )}
                {!edition.isCurrent && (
                  <a class="home-text-link" href={editionInfoUrl(edition.id)}>
                    Información de la edición
                    <Icon name="arrow-up-right" size={18} />
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}

        <div class="home-edition-bar" id="ediciones">
          <label>
            <span>Ediciones</span>
            <select data-edition-select aria-label="Elegir edición de Break The Beat">
              {editions.map((edition) => (
                <option value={edition.id} selected={edition.isCurrent}>
                  {edition.shortLabel} · {edition.year}
                </option>
              ))}
            </select>
          </label>
          {editions.map((edition) => (
            <div class="home-edition-meta" data-edition-panel={edition.id} hidden={!edition.isCurrent} aria-live="polite">
              <span>{edition.location}</span>
              <strong>{edition.status}</strong>
            </div>
          ))}
        </div>
      </section>

      <div class="home-tape" aria-hidden="true">
        <div class="home-tape-track">
          {Array.from({ length: 2 }, () => (
            <div class="home-tape-group">
              {Array.from({ length: 12 }, () => (
                <span>
                  <span><strong>break</strong> your <em>limits</em></span>
                  <img src={withBase("/assets/home-2026/dancer.svg")} width="24" height="39" alt="" />
                </span>
              ))}
            </div>
          ))}
        </div>
      </div>

      <section class="home-about" id="evento">
        <img
          class="home-about-image"
          src={withBase("/assets/home-2026/community-breaker.webp")}
          width="2200"
          height="1467"
          alt="Breaker bailando en un espacio urbano de Guayaquil"
          loading="lazy"
          decoding="async"
        />
        <div class="home-about-shade" aria-hidden="true"></div>
        <div class="home-about-title">
          <h2>
            <span>Más que</span>
            <strong>un torneo,</strong>
            <span>una comunidad</span>
          </h2>
        </div>
        <div class="home-about-copy">
          <p>
            El breakdance ha sido históricamente un refugio. Desde inicios de los años 90 se comenzaron a reunir
            jóvenes alrededor del breaking como herramienta de resistencia y orgullo barrial.
          </p>
          <p>
            Break The Beat es una competencia nacional de breakdance creada para visibilizar el talento, la
            disciplina y las historias de sus bailarines.
          </p>
          <img src={withBase("/assets/home-2026/ucg-white.webp")} width="900" height="381" alt="Universidad Casa Grande" />
        </div>
      </section>

      <section class="home-impact" id="impacto">
        <div class="home-impact-heading">
          <h2>Lo que <strong>ya logramos</strong></h2>
        </div>
        <div class="home-stat-grid" aria-label="Cifras acumuladas de Break The Beat">
          <article><b>↗</b><strong>+500 asistentes</strong><span>En nuestras anteriores dos ediciones</span></article>
          <article><b>↗</b><strong>+50 breakers</strong><span>Inscritos en diferentes categorías</span></article>
          <article><b>↗</b><strong>+40K en medios</strong><span>Vistas e interacciones en medios</span></article>
          <article><b>↗</b><strong>1 documental</strong><span>Con reconocimientos internacionales</span></article>
        </div>
        <div class="home-gallery" aria-label="Galería de ediciones anteriores">
          {galleryImages.map((src) => <img src={src} width="1100" height="734" alt="" loading="lazy" decoding="async" />)}
        </div>
      </section>

      <section class="home-allies" aria-label="Sponsors de Break The Beat 2026">
        <h2 class="sr-only">Sponsors de Break The Beat 2026</h2>
        <div class="home-allies-logos">
          {currentSponsors.map((sponsor) =>
            sponsor.logo ? (
              <img src={withBase(sponsor.logo)} width="480" height="320" alt={sponsor.name} loading="lazy" decoding="async" />
            ) : (
              <strong>{sponsor.name}</strong>
            )
          )}
        </div>
      </section>

      <section class="home-final-cta">
        <img src={withBase("/assets/home-2026/dancer.svg")} width="115" height="184" alt="" aria-hidden="true" />
        <h2>La pista te espera</h2>
        <div>
          <a class="home-button home-button-pink" href={withBase("/inscripcion/")}>Inscribirme</a>
          <a class="home-button home-button-paper" href={withBase("/evento/")}>Información del evento</a>
        </div>
      </section>
    </main>

    <SiteFooter variant="home" />

    <script>
      import "../scripts/edition-switcher";

      const countdown = document.querySelector<HTMLElement>("[data-countdown]");
      if (countdown) {
        const target = new Date(countdown.dataset.countdown ?? "").getTime();
        const days = countdown.querySelector<HTMLElement>("[data-countdown-days]");
        const hours = countdown.querySelector<HTMLElement>("[data-countdown-hours]");
        const minutes = countdown.querySelector<HTMLElement>("[data-countdown-minutes]");
        const seconds = countdown.querySelector<HTMLElement>("[data-countdown-seconds]");
        const live = countdown.querySelector<HTMLElement>("[data-countdown-live]");

        const updateCountdown = () => {
          const remaining = Math.max(0, target - Date.now());
          const dayValue = Math.floor(remaining / 86_400_000);
          const hourValue = Math.floor((remaining % 86_400_000) / 3_600_000);
          const minuteValue = Math.floor((remaining % 3_600_000) / 60_000);
          const secondValue = Math.floor((remaining % 60_000) / 1_000);

          if (days) days.textContent = String(dayValue).padStart(2, "0");
          if (hours) hours.textContent = String(hourValue).padStart(2, "0");
          if (minutes) minutes.textContent = String(minuteValue).padStart(2, "0");
          if (seconds) seconds.textContent = String(secondValue).padStart(2, "0");
          if (live) live.textContent = `${dayValue} días, ${hourValue} horas y ${minuteValue} minutos para el evento.`;
        };

        updateCountdown();
        window.setInterval(updateCountdown, 1_000);
      }
    </script>
  </body>
</html>
