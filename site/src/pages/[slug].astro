---
import Analytics from "../components/Analytics.astro";
import Icon from "../components/Icon.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { donationPayment, donationUses, event, featurePages } from "../data/site";
import { withBase } from "../utils/paths";
import "../styles/global.css";

export function getStaticPaths() {
  return featurePages.map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props;
const pageTitle = `${page.title} | ${event.title}`;
const description = page.summary;
const isDonationPage = page.slug === "apoyar";
---

<!doctype html>
<html
  lang="es"
  data-home-overhaul={isDonationPage ? true : undefined}
  data-donation-overhaul={isDonationPage ? true : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={withBase(page.image)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={withBase("/assets/favicon.png")} />
    {isDonationPage && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet"
        />
        <style
          is:inline
          set:html={`
            @font-face {
              font-family: "Aurochs Heavy";
              src: url("${withBase("/assets/home-2026/aurochs-heavy.woff")}") format("woff");
              font-style: normal;
              font-weight: 800;
              font-display: swap;
            }
            @font-face {
              font-family: "Aurochs Regular";
              src: url("${withBase("/assets/home-2026/aurochs-regular.woff")}") format("woff");
              font-style: normal;
              font-weight: 500;
              font-display: swap;
            }
          `}
        ></style>
      </>
    )}
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader variant={isDonationPage ? "home" : "default"} />
    {isDonationPage ? (
      <main id="inicio" class="donation-page-modern">
        <section class="donation-hero-modern" aria-labelledby="donation-hero-title">
          <img
            class="donation-hero-image-modern"
            src={withBase(page.image)}
            width="1600"
            height="900"
            alt={page.alt}
            fetchpriority="high"
          />
          <div class="donation-hero-overlay-modern" aria-hidden="true"></div>
          <div class="donation-hero-content-modern">
            <p class="donation-kicker">Donaciones · Break The Beat 2026</p>
            <h1 id="donation-hero-title">
              <span>Tu aporte</span>
              <strong>mueve la cultura</strong>
            </h1>
            <p>{page.summary}</p>
            <a
              class="home-button home-button-pink"
              href={donationPayment.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              Donar con PayPhone
              <Icon name="arrow-up-right" size={18} />
            </a>
          </div>
        </section>

        <section class="donation-purpose" aria-labelledby="donation-purpose-title">
          <div class="donation-purpose-heading">
            <div>
              <p class="donation-kicker donation-kicker-dark">¿Para qué sirve tu aporte?</p>
              <h2 id="donation-purpose-title">Cada donación abre una oportunidad.</h2>
            </div>
            <p>
              Los aportes se destinan a actividades y costos reales del proyecto, priorizados según
              las necesidades de la edición 2026.
            </p>
          </div>
          <div class="donation-purpose-grid">
            {donationUses.map((item) => (
              <article>
                <span>{item.number}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="donation-checkout" id="donar" aria-labelledby="donation-checkout-title">
          <div class="donation-checkout-heading">
            <p class="donation-kicker">Donación en línea</p>
            <h2 id="donation-checkout-title">Dona el monto que tú elijas.</h2>
            <p>
              Abre PayPhone, ingresa cuánto quieres aportar y completa el pago en su plataforma.
            </p>
          </div>

          <div class="donation-checkout-grid">
            <article class="donation-payment-card" aria-labelledby="donation-payment-title">
              <div class="donation-card-heading-modern">
                <div>
                  <p>Enlace oficial</p>
                  <h3 id="donation-payment-title">Dona con PayPhone</h3>
                </div>
                <Icon name="hand-heart" size={30} />
              </div>

              <p class="donation-payment-copy">
                Escanea el QR o continua en PayPhone, indicando el monto y siguiendo las
                instrucciones para completar tu donación
              </p>
              <img
                class="donation-payment-qr"
                src={withBase("/assets/payphone-donation-qr.jpeg")}
                width="1280"
                height="1280"
                alt="Código QR para donar a Break The Beat mediante PayPhone"
                loading="eager"
                decoding="async"
              />
              <a
                class="home-button home-button-pink donation-payment-button"
                href={donationPayment.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                Ir a PayPhone y donar
                <Icon name="arrow-up-right" size={18} />
              </a>
              <p class="donation-help">
                El enlace se abrirá en una pestaña nueva y el pago se procesará en PayPhone.
              </p>
            </article>

            <aside class="donation-payment-guide" aria-labelledby="donation-guide-title">
              <p class="donation-kicker">Proceso simple</p>
              <h3 id="donation-guide-title">Abre el enlace y dona.</h3>
              <ol>
                <li>
                  <span>1</span>
                  <div>
                    <strong>Abre PayPhone</strong>
                    <p>Usa el botón para entrar al enlace oficial de donación.</p>
                  </div>
                </li>
                <li>
                  <span>2</span>
                  <div>
                    <strong>Elige cuánto donar</strong>
                    <p>Escribe el monto que quieras aportar a Break The Beat.</p>
                  </div>
                </li>
                <li>
                  <span>3</span>
                  <div>
                    <strong>Completa el pago</strong>
                    <p>Sigue las instrucciones de PayPhone para finalizar la donación.</p>
                  </div>
                </li>
              </ol>
              <p class="donation-security-note">
                Break The Beat nunca te pedirá claves bancarias ni códigos de seguridad por mensaje.
              </p>
            </aside>
          </div>
        </section>
      </main>
    ) : (
      <main id="inicio" class="detail-page">
        <section class="detail-hero section-dark">
          <div class="detail-media" aria-hidden="true">
            <img src={withBase(page.image)} alt="" />
          </div>
          <div class="detail-overlay"></div>
          <div class="detail-content">
            <a class="text-link detail-back" href={withBase("/")}>
              <Icon name="arrow-left" size={18} />
              Volver
            </a>
            <p class="eyebrow">{page.eyebrow}</p>
            <h1>{page.title}</h1>
            <p>{page.summary}</p>
            <a class="button button-primary" href={`mailto:${event.email}`}>
              Contacto oficial
              <Icon name="mail" size={18} />
            </a>
          </div>
        </section>
        <section class="detail-body section-light">
          <div class="section-heading compact">
            <div class="section-label">Detalle</div>
            <h2>Lo importante de esta parte.</h2>
          </div>
          <div class="detail-list">
            {page.bullets.map((item) => (
              <article>
                <span aria-hidden="true"></span>
                <p>{item}</p>
              </article>
            ))}
          </div>
        </section>
      </main>
    )}
    <SiteFooter variant={isDonationPage ? "home" : "default"} />
    <Analytics />
  </body>
</html>
