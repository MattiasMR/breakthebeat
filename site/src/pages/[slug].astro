---
import Icon from "../components/Icon.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { event, featurePages } from "../data/site";
import { withBase } from "../utils/paths";
import "../styles/global.css";

export function getStaticPaths() {
  return featurePages.map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props;
const pageTitle = `${page.title} | ${event.title}`;
const description = page.summary;
const isDonationPage = page.slug === "apoyar";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={withBase(page.image)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={withBase("/assets/favicon.png")} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader />
    <main id="inicio" class="detail-page">
      <section class="detail-hero section-dark">
        <div class="detail-media" aria-hidden="true">
          <img src={withBase(page.image)} alt="" />
        </div>
        <div class="detail-overlay"></div>
        <div class="detail-content">
          <a class="text-link detail-back" href={withBase("/")}>
            <Icon name="arrow-left" size={18} />
            Volver
          </a>
          <p class="eyebrow">{page.eyebrow}</p>
          <h1>{page.title}</h1>
          <p>{page.summary}</p>
          {isDonationPage ? (
            <a class="button button-primary" href="#donar">
              Elegir cuánto donar
              <Icon name="hand-heart" size={18} />
            </a>
          ) : (
            <a class="button button-primary" href={`mailto:${event.email}`}>
              Contacto oficial
              <Icon name="mail" size={18} />
            </a>
          )}
        </div>
      </section>

      {isDonationPage ? (
        <section class="donation-section section-light" id="donar">
          <div class="section-heading compact">
            <div class="section-label">Aporte directo</div>
            <h2>Elige el monto que quieres donar.</h2>
            <p>
              Indica tu aporte y te ayudaremos a solicitar los datos oficiales de transferencia
              al equipo de Break The Beat.
            </p>
          </div>

          <div class="donation-layout">
            <form class="donation-card" data-donation-form data-contact-email={event.email} novalidate>
              <fieldset>
                <legend>Monto en dólares</legend>
                <div class="donation-amounts">
                  {[10, 25, 50, 100].map((amount) => (
                    <label class="donation-option">
                      <input type="radio" name="donationAmount" value={amount} />
                      <span>USD {amount}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <label class="donation-custom">
                <span>Otro monto</span>
                <div>
                  <strong>USD</strong>
                  <input
                    type="number"
                    name="customAmount"
                    min="1"
                    step="1"
                    inputmode="decimal"
                    placeholder="Ingresa el monto"
                    aria-describedby="donation-help"
                  />
                </div>
              </label>

              <button class="button button-primary" type="submit">
                Solicitar datos para donar
                <Icon name="mail" size={18} />
              </button>
              <p class="donation-feedback" data-donation-feedback aria-live="polite"></p>
              <p class="donation-help" id="donation-help">
                Esta página no realiza el cobro. Abriremos un correo con el monto elegido para que
                el equipo confirme la cuenta receptora y la forma de rendición.
              </p>
            </form>

            <div class="detail-list donation-assurances">
              {page.bullets.map((item) => (
                <article>
                  <span aria-hidden="true"></span>
                  <p>{item}</p>
                </article>
              ))}
            </div>
          </div>
        </section>
      ) : (
        <section class="detail-body section-light">
          <div class="section-heading compact">
            <div class="section-label">Detalle</div>
            <h2>Lo importante de esta parte.</h2>
          </div>
          <div class="detail-list">
            {page.bullets.map((item) => (
              <article>
                <span aria-hidden="true"></span>
                <p>{item}</p>
              </article>
            ))}
          </div>
        </section>
      )}
    </main>
    <SiteFooter />
    <script>
      import "../scripts/donation";
    </script>
  </body>
</html>
