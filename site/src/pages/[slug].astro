---
import Analytics from "../components/Analytics.astro";
import Icon from "../components/Icon.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { donationAccount, donationUses, event, featurePages } from "../data/site";
import { withBase } from "../utils/paths";
import "../styles/global.css";

export function getStaticPaths() {
  return featurePages.map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props;
const pageTitle = `${page.title} | ${event.title}`;
const description = page.summary;
const isDonationPage = page.slug === "apoyar";
---

<!doctype html>
<html
  lang="es"
  data-home-overhaul={isDonationPage ? true : undefined}
  data-donation-overhaul={isDonationPage ? true : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={withBase(page.image)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={withBase("/assets/favicon.png")} />
    {isDonationPage && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet"
        />
        <style
          is:inline
          set:html={`
            @font-face {
              font-family: "Aurochs Heavy";
              src: url("${withBase("/assets/home-2026/aurochs-heavy.woff")}") format("woff");
              font-style: normal;
              font-weight: 800;
              font-display: swap;
            }
            @font-face {
              font-family: "Aurochs Regular";
              src: url("${withBase("/assets/home-2026/aurochs-regular.woff")}") format("woff");
              font-style: normal;
              font-weight: 500;
              font-display: swap;
            }
          `}
        ></style>
      </>
    )}
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader variant={isDonationPage ? "home" : "default"} />
    {isDonationPage ? (
      <main id="inicio" class="donation-page-modern">
        <section class="donation-hero-modern" aria-labelledby="donation-hero-title">
          <img
            class="donation-hero-image-modern"
            src={withBase(page.image)}
            width="1600"
            height="900"
            alt={page.alt}
            fetchpriority="high"
          />
          <div class="donation-hero-overlay-modern" aria-hidden="true"></div>
          <div class="donation-hero-content-modern">
            <p class="donation-kicker">Donaciones · Break The Beat 2026</p>
            <h1 id="donation-hero-title">
              <span>Tu aporte</span>
              <strong>mueve la cultura</strong>
            </h1>
            <p>{page.summary}</p>
            <a class="home-button home-button-pink" href="#donar">
              Ver datos para transferir
              <Icon name="arrow-right" size={18} />
            </a>
          </div>
        </section>

        <section class="donation-purpose" aria-labelledby="donation-purpose-title">
          <div class="donation-purpose-heading">
            <div>
              <p class="donation-kicker donation-kicker-dark">¿Para qué sirve tu aporte?</p>
              <h2 id="donation-purpose-title">Cada donación abre una oportunidad.</h2>
            </div>
            <p>
              Los aportes se destinan a actividades y costos reales del proyecto, priorizados según
              las necesidades de la edición 2026.
            </p>
          </div>
          <div class="donation-purpose-grid">
            {donationUses.map((item) => (
              <article>
                <span>{item.number}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="donation-transfer" id="donar" aria-labelledby="donation-transfer-title">
          <div class="donation-transfer-heading">
            <p class="donation-kicker">Transferencia bancaria</p>
            <h2 id="donation-transfer-title">Dona el monto que tú elijas.</h2>
            <p>
              No seleccionas un monto aquí: copia los datos y define tu aporte directamente en la
              aplicación o banca web de tu banco.
            </p>
          </div>

          <div class="donation-transfer-grid">
            <article class="donation-account-card-modern" aria-labelledby="donation-account-title">
              <div class="donation-card-heading-modern">
                <div>
                  <p>Cuenta receptora</p>
                  <h3 id="donation-account-title">Datos para transferir</h3>
                </div>
                <Icon name="hand-heart" size={30} />
              </div>

              <dl class="donation-account-details">
                {[
                  { label: "Banco", value: donationAccount.bank },
                  { label: "Tipo de cuenta", value: donationAccount.accountType },
                  { label: "Número de cuenta", value: donationAccount.accountNumber, emphasize: true },
                  { label: "Titular", value: donationAccount.holder },
                  {
                    label: donationAccount.identificationType,
                    value: donationAccount.identification
                  }
                ].map((field) => (
                  <div class="donation-account-row">
                    <div>
                      <dt>{field.label}</dt>
                      <dd class:list={{ "is-emphasized": field.emphasize }}>{field.value}</dd>
                    </div>
                    <button
                      class="donation-copy-field"
                      type="button"
                      data-copy-value={field.value}
                      data-copy-name={field.label}
                      aria-label={`Copiar ${field.label.toLowerCase()}`}
                    >
                      <Icon name="copy" size={17} />
                      <span data-copy-button-label>Copiar</span>
                    </button>
                  </div>
                ))}
              </dl>

              <button
                class="home-button home-button-pink donation-copy-all"
                type="button"
                data-copy-value={`Banco: ${donationAccount.bank}\nTipo de cuenta: ${donationAccount.accountType}\nNúmero de cuenta: ${donationAccount.accountNumber}\nTitular: ${donationAccount.holder}\n${donationAccount.identificationType}: ${donationAccount.identification}\nMotivo sugerido: ${donationAccount.suggestedReason}`}
                data-copy-name="Todos los datos"
              >
                <Icon name="copy" size={18} />
                <span data-copy-button-label>Copiar todos los datos</span>
              </button>
              <p class="donation-feedback" data-donation-feedback aria-live="polite"></p>
              <p class="donation-help">
                Verifica que tu banco muestre como titular a
                <strong>{donationAccount.holder}</strong> antes de confirmar.
              </p>
            </article>

            <aside class="donation-bank-guide" aria-labelledby="donation-guide-title">
              <p class="donation-kicker">Proceso simple</p>
              <h3 id="donation-guide-title">Abre tu banco y transfiere.</h3>
              <ol>
                <li>
                  <span>1</span>
                  <div>
                    <strong>Copia los datos</strong>
                    <p>Usa el botón para llevarte toda la información de una sola vez.</p>
                  </div>
                </li>
                <li>
                  <span>2</span>
                  <div>
                    <strong>Elige cuánto aportar</strong>
                    <p>Ingresa el monto directamente en la aplicación de tu banco.</p>
                  </div>
                </li>
                <li>
                  <span>3</span>
                  <div>
                    <strong>Confirma al titular</strong>
                    <p>Comprueba el nombre de la cuenta antes de completar la transferencia.</p>
                  </div>
                </li>
              </ol>
              <p class="donation-security-note">
                Break The Beat nunca te pedirá claves bancarias ni códigos de seguridad.
              </p>
            </aside>
          </div>
        </section>
      </main>
    ) : (
      <main id="inicio" class="detail-page">
        <section class="detail-hero section-dark">
          <div class="detail-media" aria-hidden="true">
            <img src={withBase(page.image)} alt="" />
          </div>
          <div class="detail-overlay"></div>
          <div class="detail-content">
            <a class="text-link detail-back" href={withBase("/")}>
              <Icon name="arrow-left" size={18} />
              Volver
            </a>
            <p class="eyebrow">{page.eyebrow}</p>
            <h1>{page.title}</h1>
            <p>{page.summary}</p>
            <a class="button button-primary" href={`mailto:${event.email}`}>
              Contacto oficial
              <Icon name="mail" size={18} />
            </a>
          </div>
        </section>
        <section class="detail-body section-light">
          <div class="section-heading compact">
            <div class="section-label">Detalle</div>
            <h2>Lo importante de esta parte.</h2>
          </div>
          <div class="detail-list">
            {page.bullets.map((item) => (
              <article>
                <span aria-hidden="true"></span>
                <p>{item}</p>
              </article>
            ))}
          </div>
        </section>
      </main>
    )}
    <SiteFooter variant={isDonationPage ? "home" : "default"} />
    <script>
      import "../scripts/donation";
    </script>
    <Analytics />
  </body>
</html>
